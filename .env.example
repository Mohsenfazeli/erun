# Copy to .env for local testing. Set the real values in Vercel, never in git.
# Required: Resend API key (https://resend.com/api-keys), "Sending access" only.
RESEND_API_KEY=
# Optional overrides (defaults shown).
# CONTACT_TO_EMAIL=contact@erungroup.ca
# CONTACT_FROM_EMAIL=Erun Website <website@erungroup.ca>

# Lab HR Assistant (optional). Without a key it answers offline by quoting the handbook.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
